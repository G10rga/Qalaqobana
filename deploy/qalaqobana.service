[Unit]
Description=Qalaqobana multiplayer word game
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/qalaqobana
EnvironmentFile=/var/www/qalaqobana/.env
ExecStart=/var/www/qalaqobana/.venv/bin/python run.py
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
