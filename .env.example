FLASK_APP=run.py
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string

# App listens locally; nginx proxies public HTTPS here
HOST=127.0.0.1
PORT=5017
BEHIND_PROXY=1

# Comma-separated, or * for any
CORS_ORIGINS=https://qalaqobana.g1orga.dev

# Optional override (default: data/qalaqobana.db under the app root)
# DATABASE_PATH=/var/www/qalaqobana/data/qalaqobana.db
