FLASK_APP=run.py
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string

# App listens locally; nginx proxies public HTTPS here
HOST=127.0.0.1
PORT=5017
BEHIND_PROXY=1

# Comma-separated, or * for any
CORS_ORIGINS=https://qalaqobana.g1orga.dev

# PostgreSQL (required in production)
DATABASE_URL=postgresql+psycopg://qalaqobana:CHANGE_ME@127.0.0.1:5432/qalaqobana

# Seed file (default: data/qalaqobana_words.csv)
# LEXICON_CSV=/var/www/qalaqobana/data/qalaqobana_words.csv

# Local-only fallback — do not enable on the server
# ALLOW_SQLITE=1
